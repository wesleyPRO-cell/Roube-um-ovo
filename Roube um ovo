--=========================================================
-- LÓGICA: SPEED
--=========================================================
local function applySpeed(value)
    State.Speed = clamp(value, CONFIG.MinSpeed, CONFIG.MaxSpeed)
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = State.Speed
        end
    end
    -- Atualiza UI
    SpeedValue.Text = tostring(State.Speed)
    local pct = State.Speed / CONFIG.MaxSpeed
    tween(SliderFill, 0.15, { Size = UDim2.new(pct, 0, 1, 0) })
    tween(SliderKnob, 0.15, { Position = UDim2.new(pct, 0, 0.5, 0) })
end

